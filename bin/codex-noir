#!/bin/sh
# This launcher preserves Codex's existing home, authentication, and CLI arguments.
codex_noir_binary="$HOME/.local/share/codex-noir/0.153.4/bin/codex"
if [ ! -x "$codex_noir_binary" ]; then
    printf '%s\n' "Codex Noir is not installed at $codex_noir_binary" >&2
    exit 127
fi

# Defaults come before user arguments so explicit -c overrides still win.
# Electron terminals (Cursor, VS Code) repaint slowly, often without GPU acceleration. Cap the
# decorative redraws there unless a rate was chosen; the TUI reads CODEX_NOIR_FPS.
if [ -z "${CODEX_NOIR_FPS-}" ] && [ "${TERM_PROGRAM-}" = "vscode" ]; then
    CODEX_NOIR_FPS=8
    export CODEX_NOIR_FPS
fi

if [ -f "${CODEX_HOME:-$HOME/.codex}/themes/noir-velocity.tmTheme" ]; then
    exec "$codex_noir_binary" \
        -c 'check_for_update_on_startup=false' \
        -c 'tui.theme="noir-velocity"' \
        "$@"
fi
exec "$codex_noir_binary" -c 'check_for_update_on_startup=false' "$@"
