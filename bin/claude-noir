#!/bin/sh
# Claude Code in the Noir terminal layout: the mascot and its shiba run in a small pane above
# the real `claude`, which keeps its own authentication, settings, and arguments. Background
# hooks report the session's activity and effort to a private state file for the pane's rail.
set -eu

share="${CLAUDE_NOIR_SHARE:-$HOME/.local/share/claude-noir}"
dancer="$share/dancer.py"
pulse="$share/pulse.py"
conf="$share/tmux.conf"
rows="${CLAUDE_NOIR_ROWS:-8}"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/claude-noir"

if ! command -v claude >/dev/null 2>&1; then
    printf '%s\n' "claude-noir: the claude command is not installed" >&2
    exit 127
fi
if ! command -v tmux >/dev/null 2>&1 || [ ! -f "$dancer" ] || [ "${CLAUDE_NOIR_DANCER-}" = "off" ]; then
    # Without tmux or the dancer, run Claude Code directly so nothing is lost.
    exec claude "$@"
fi
if [ -n "${TMUX-}" ]; then
    # Already inside tmux: nesting servers is confusing, so run plainly.
    exec claude "$@"
fi

# Single-quote a string for the shell that runs tmux's command strings.
quote() {
    printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

session="claude-noir-$$"
socket="claude-noir"
state="$state_dir/$session.json"

# Quote every argument for tmux's shell command string. Record an explicit effort, and a
# --settings of the user's own, which the hook settings below must not displace.
arguments=''
ultracode=0
launch_effort=''
custom_settings=0
parse_options=1
previous=''
for argument in "$@"; do
    arguments="$arguments $(quote "$argument")"
    if [ "$parse_options" -eq 0 ]; then
        continue
    fi
    if [ "$argument" = "--" ]; then
        parse_options=0
        continue
    fi
    case "$argument" in
        --settings|--settings=*) custom_settings=1 ;;
    esac
    effort=''
    case "$argument" in
        --effort=*) effort=${argument#--effort=} ;;
        *) if [ "$previous" = "--effort" ]; then effort=$argument; fi ;;
    esac
    case "$effort" in
        low|medium|high|xhigh|max) launch_effort=$effort; ultracode=0 ;;
        ultracode) launch_effort=''; ultracode=1 ;;
    esac
    previous="$argument"
done

environment="CLAUDE_NOIR_STATE=$(quote "$state") CLAUDE_NOIR_ULTRACODE=$ultracode CLAUDE_NOIR_EFFORT=$(quote "$launch_effort")"
command="claude$arguments"
if [ -f "$pulse" ] && [ "$custom_settings" -eq 0 ]; then
    # Register the pulse as a background hook for this session only. Hooks passed this way
    # merge with the user's own settings instead of replacing them.
    hook=$(printf 'python3 %s' "$(quote "$pulse")" | sed 's/\\/\\\\/g; s/"/\\"/g')
    hooks=''
    for event in SessionStart UserPromptSubmit PreToolUse PostToolUse PostToolUseFailure \
        PermissionRequest Notification Stop StopFailure PostModelSwitch ConfigChange SessionEnd; do
        hooks="$hooks${hooks:+,}\"$event\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"$hook\",\"async\":true}]}]"
    done
    command="claude --settings $(quote "{\"hooks\":{$hooks}}")$arguments"
fi

mkdir -p "$state_dir"
chmod 700 "$state_dir"
rm -f "$state"
trap 'rm -f "$state"' EXIT

columns=$(tput cols 2>/dev/null || echo 120)
lines=$(tput lines 2>/dev/null || echo 40)

tmux -L "$socket" -f "$conf" new-session -d -s "$session" -x "$columns" -y "$lines" \
    "$environment $command; tmux -L $socket kill-session -t $session"
tmux -L "$socket" split-window -t "$session" -b -l "$rows" "$environment python3 $(quote "$dancer")"
tmux -L "$socket" select-pane -t "$session:.{bottom}"
tmux -L "$socket" attach-session -t "$session"
