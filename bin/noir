#!/bin/sh
# Source checkout launcher; the installer writes a launcher for its private package.
noir_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
noir_python="$noir_root/.venv/bin/python"
if [ ! -x "$noir_python" ]; then
    printf '%s\n' 'Noir needs its Python environment. Run:' >&2
    printf '%s\n' 'python3 -m venv .venv' '.venv/bin/pip install -r scripts/requirements-workspace.txt' >&2
    exit 1
fi
exec "$noir_python" "$noir_root/scripts/noir-workspace.py" "$@"
