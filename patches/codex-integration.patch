diff --git a/codex-rs/tui/tests/suite/focus_palette.rs b/codex-rs/tui/tests/suite/focus_palette.rs
index 71a4cb5..36c3858 100644
--- a/codex-rs/tui/tests/suite/focus_palette.rs
+++ b/codex-rs/tui/tests/suite/focus_palette.rs
@@ -229,6 +229,19 @@ impl PtyCodex {
     }
 
     pub(super) fn screen_contains(&self, text: &str) -> bool {
+        // A PTY read can stop midway through a synchronized redraw. vt100 does
+        // not defer those cells, so only inspect frames after their end marker.
+        let begin = self
+            .output
+            .windows(b"\x1b[?2026h".len())
+            .rposition(|window| window == b"\x1b[?2026h");
+        let end = self
+            .output
+            .windows(b"\x1b[?2026l".len())
+            .rposition(|window| window == b"\x1b[?2026l");
+        if begin.is_some_and(|begin| end.is_none_or(|end| begin > end)) {
+            return false;
+        }
         self.parser.screen().contents().contains(text)
     }
 
