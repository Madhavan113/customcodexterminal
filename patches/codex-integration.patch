+    /// Move the insertion cursor to the editable cell selected inside the last rendered viewport.
+    ///
+    /// Wrapped-line ranges include a one-byte cursor sentinel, so the end of a visual row maps to
+    /// the insertion point immediately after its visible text. Clicking a wide grapheme maps to
+    /// its leading boundary, matching the cell-oriented cursor used by terminal emulators.
+    pub(crate) fn set_cursor_from_screen_position(
+        &mut self,
+        area: Rect,
+        state: TextAreaState,
+        column: u16,
+        row: u16,
+    ) -> bool {
+        if area.is_empty()
+            || column < area.x
+            || column >= area.right()
+            || row < area.y
+            || row >= area.bottom()
+        {
+            return false;
+        }
+
+        let lines = self.wrapped_lines(area.width);
+        let effective_scroll = self.effective_scroll(area, &lines, state.scroll);
+        let line_index =
+            usize::from(effective_scroll).saturating_add(usize::from(row.saturating_sub(area.y)));
+        let Some(line) = lines.get(line_index).cloned() else {
+            return false;
+        };
+        drop(lines);
+        let line_end = line.end.saturating_sub(1).min(self.text.len());
+        let target_col = usize::from(column.saturating_sub(area.x));
+        let visible = wrapping::visible_prefix(&self.text[line.start..line_end], area.width);
+        let visible = text_for_display(visible);
+        let mut display_col = 0usize;
+        let mut target = line.start + visible.len();
+        for (offset, grapheme) in visible.grapheme_indices(/*is_extended*/ true) {
+            let grapheme_width = display_width(grapheme);
+            if target_col < display_col.saturating_add(grapheme_width.max(1)) {
+                target = line.start + offset;
+                break;
+            }
+            display_col = display_col.saturating_add(grapheme_width);
+        }
+
+        let previous = self.cursor_pos;
+        self.set_cursor(target);
+        self.cursor_pos != previous
+    }
