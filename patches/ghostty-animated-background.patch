diff --git a/pkg/wuffs/src/gif.zig b/pkg/wuffs/src/gif.zig
new file mode 100644
index 0000000..1994592
--- /dev/null
+++ b/pkg/wuffs/src/gif.zig
@@ -0,0 +1,268 @@
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+const c = @import("c.zig").c;
+const Error = @import("error.zig").Error;
+const check = @import("error.zig").check;
+const ImageData = @import("main.zig").ImageData;
+const maximum_image_size = @import("main.zig").maximum_image_size;
+const mul = std.math.mul;
+
+const log = std.log.scoped(.wuffs_gif);
+
+/// Wuffs measures frame durations in flicks: 1/705,600,000 of a second.
+const flicks_per_second: u64 = 705_600_000;
+
+/// Frames shorter than this are treated like browsers treat them: a zero or
+/// near-zero GIF delay plays at ten frames per second.
+const minimum_duration_ns: u64 = 20 * std.time.ns_per_ms;
+const default_duration_ns: u64 = 100 * std.time.ns_per_ms;
+
+/// Upper bound on decoded frames so a hostile file cannot exhaust memory.
+const maximum_frames: usize = 1024;
+
+/// One fully composited RGBA frame of an animation.
+pub const Frame = struct {
+    /// RGBA non-premultiplied pixels, `width * height * 4` bytes.
+    data: []u8,
+    /// How long this frame stays on screen.
+    duration_ns: u64,
+};
+
+/// A decoded animation. Every frame is the complete canvas, with disposal
+/// already applied, so a renderer can upload frames independently.
+pub const AnimationData = struct {
+    width: u32,
+    height: u32,
+    frames: []Frame,
+
+    pub fn deinit(self: AnimationData, alloc: Allocator) void {
+        for (self.frames) |frame| alloc.free(frame.data);
+        alloc.free(self.frames);
+    }
+
+    /// Total duration of one loop.
+    pub fn loopDurationNs(self: AnimationData) u64 {
+        var total: u64 = 0;
+        for (self.frames) |frame| total += frame.duration_ns;
+        return total;
+    }
+};
+
+/// Decode only the first frame of a GIF as a still image.
+pub fn decode(alloc: Allocator, data: []const u8) Error!ImageData {
+    var animation = try decodeAnimation(alloc, data);
+    defer animation.deinit(alloc);
+    const first = animation.frames[0].data;
+    animation.frames[0].data = &.{};
+    return .{
+        .width = animation.width,
+        .height = animation.height,
+        .data = first,
+    };
+}
+
+/// Decode every frame of a GIF into composited RGBA canvases.
+pub fn decodeAnimation(alloc: Allocator, data: []const u8) Error!AnimationData {
+    // See png.zig for why the decoder is heap allocated through Zig.
+    const decoder_buf = try alloc.alloc(u8, c.sizeof__wuffs_gif__decoder());
+    defer alloc.free(decoder_buf);
+
+    const decoder: ?*c.wuffs_gif__decoder = @ptrCast(decoder_buf);
+    {
+        const status = c.wuffs_gif__decoder__initialize(
+            decoder,
+            c.sizeof__wuffs_gif__decoder(),
+            c.WUFFS_VERSION,
+            0,
+        );
+        try check(log, &status);
+    }
+
+    var source_buffer: c.wuffs_base__io_buffer = .{
+        .data = .{ .ptr = @ptrCast(@constCast(data.ptr)), .len = data.len },
+        .meta = .{
+            .wi = data.len,
+            .ri = 0,
+            .pos = 0,
+            .closed = true,
+        },
+    };
+
+    var image_config: c.wuffs_base__image_config = undefined;
+    {
+        const status = c.wuffs_gif__decoder__decode_image_config(
+            decoder,
+            &image_config,
+            &source_buffer,
+        );
+        try check(log, &status);
+    }
+
+    const width = c.wuffs_base__pixel_config__width(&image_config.pixcfg);
+    const height = c.wuffs_base__pixel_config__height(&image_config.pixcfg);
+
+    c.wuffs_base__pixel_config__set(
+        &image_config.pixcfg,
+        c.WUFFS_BASE__PIXEL_FORMAT__RGBA_NONPREMUL,
+        c.WUFFS_BASE__PIXEL_SUBSAMPLING__NONE,
+        width,
+        height,
+    );
+
+    const size: usize = try mul(
+        usize,
+        try mul(usize, width, height),
+        @sizeOf(c.wuffs_base__color_u32_argb_premul),
+    );
+    if (size > maximum_image_size) {
+        log.warn("image size {d} is larger than the maximum allowed ({d})", .{ size, maximum_image_size });
+        return error.Overflow;
+    }
+
+    // The canvas every frame is composited onto, plus a copy for frames that
+    // ask to restore the previous canvas when they are disposed.
+    const canvas = try alloc.alloc(u8, size);
+    defer alloc.free(canvas);
+    @memset(canvas, 0);
+    const previous = try alloc.alloc(u8, size);
+    defer alloc.free(previous);
+
+    const work_buffer = try alloc.alloc(
+        u8,
+        std.math.cast(
+            usize,
+            c.wuffs_gif__decoder__workbuf_len(decoder).max_incl,
+        ) orelse return error.OutOfMemory,
+    );
+    defer alloc.free(work_buffer);
+    const work_slice = c.wuffs_base__make_slice_u8(work_buffer.ptr, work_buffer.len);
+
+    var pixel_buffer: c.wuffs_base__pixel_buffer = undefined;
+    {
+        const status = c.wuffs_base__pixel_buffer__set_from_slice(
+            &pixel_buffer,
+            &image_config.pixcfg,
+            c.wuffs_base__make_slice_u8(canvas.ptr, canvas.len),
+        );
+        try check(log, &status);
+    }
+
+    var frames: std.ArrayList(Frame) = .empty;
+    errdefer {
+        for (frames.items) |frame| alloc.free(frame.data);
+        frames.deinit(alloc);
+    }
+
+    // Disposal of the frame just shown, applied before the next one is drawn.
+    var disposal: c.wuffs_base__animation_disposal = c.WUFFS_BASE__ANIMATION_DISPOSAL__NONE;
+    var disposal_bounds: c.wuffs_base__rect_ie_u32 = undefined;
+
+    while (frames.items.len < maximum_frames) {
+        var frame_config: c.wuffs_base__frame_config = undefined;
+        {
+            const status = c.wuffs_gif__decoder__decode_frame_config(
+                decoder,
+                &frame_config,
+                &source_buffer,
+            );
+            // wuffs reports the end of the frame list as a note whose message
+            // (without its "@" prefix) reads "base: end of data".
+            if (c.wuffs_base__status__is_note(&status)) {
+                const message = std.mem.span(c.wuffs_base__status__message(&status));
+                if (std.mem.eql(u8, message, "base: end of data")) break;
+            }
+            try check(log, &status);
+        }
+
+        switch (disposal) {
+            c.WUFFS_BASE__ANIMATION_DISPOSAL__RESTORE_BACKGROUND => clearRect(
+                canvas,
+                width,
+                disposal_bounds,
+            ),
+            c.WUFFS_BASE__ANIMATION_DISPOSAL__RESTORE_PREVIOUS => @memcpy(canvas, previous),
+            else => {},
+        }
+
+        disposal = c.wuffs_base__frame_config__disposal(&frame_config);
+        disposal_bounds = c.wuffs_base__frame_config__bounds(&frame_config);
+        if (disposal == c.WUFFS_BASE__ANIMATION_DISPOSAL__RESTORE_PREVIOUS) {
+            @memcpy(previous, canvas);
+        }
+
+        {
+            const status = c.wuffs_gif__decoder__decode_frame(
+                decoder,
+                &pixel_buffer,
+                &source_buffer,
+                c.WUFFS_BASE__PIXEL_BLEND__SRC_OVER,
+                work_slice,
+                null,
+            );
+            if (c.wuffs_base__status__is_note(&status)) {
+                const message = std.mem.span(c.wuffs_base__status__message(&status));
+                if (std.mem.eql(u8, message, "base: end of data")) break;
+            }
+            try check(log, &status);
+        }
+
+        const flicks = c.wuffs_base__frame_config__duration(&frame_config);
+        var duration_ns: u64 = @intCast(@divTrunc(
+            @as(u128, @intCast(@max(flicks, 0))) * std.time.ns_per_s,
+            flicks_per_second,
+        ));
+        if (duration_ns < minimum_duration_ns) duration_ns = default_duration_ns;
+
+        const copy = try alloc.dupe(u8, canvas);
+        errdefer alloc.free(copy);
+        try frames.append(alloc, .{ .data = copy, .duration_ns = duration_ns });
+    }
+
+    if (frames.items.len == 0) {
+        log.warn("gif contains no frames", .{});
+        return error.WuffsError;
+    }
+
+    return .{
+        .width = width,
+        .height = height,
+        .frames = try frames.toOwnedSlice(alloc),
+    };
+}
+
+fn clearRect(canvas: []u8, width: u32, bounds: c.wuffs_base__rect_ie_u32) void {
+    const x0: usize = bounds.min_incl_x;
+    const x1: usize = bounds.max_excl_x;
+    var y: usize = bounds.min_incl_y;
+    while (y < bounds.max_excl_y) : (y += 1) {
+        const start = (y * width + x0) * 4;
+        const end = (y * width + x1) * 4;
+        if (end <= canvas.len) @memset(canvas[start..end], 0);
+    }
+}
+
+test "gif_decode_000000" {
+    const data = try decode(std.testing.allocator, @embedFile("1x1#000000.gif"));
+    defer std.testing.allocator.free(data.data);
+
+    try std.testing.expectEqual(1, data.width);
+    try std.testing.expectEqual(1, data.height);
+    try std.testing.expectEqualSlices(u8, &.{ 0, 0, 0, 255 }, data.data);
+}
+
+test "gif_decode_FFFFFF" {
+    const data = try decode(std.testing.allocator, @embedFile("1x1#FFFFFF.gif"));
+    defer std.testing.allocator.free(data.data);
+
+    try std.testing.expectEqual(1, data.width);
+    try std.testing.expectEqual(1, data.height);
+    try std.testing.expectEqualSlices(u8, &.{ 255, 255, 255, 255 }, data.data);
+}
+
+test "gif_decode_animation_single_frame" {
+    const animation = try decodeAnimation(std.testing.allocator, @embedFile("1x1#FFFFFF.gif"));
+    defer animation.deinit(std.testing.allocator);
+
+    try std.testing.expectEqual(1, animation.frames.len);
+    try std.testing.expectEqual(default_duration_ns, animation.frames[0].duration_ns);
+}
